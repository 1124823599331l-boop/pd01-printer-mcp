# Optional. The default device name is PD01.
PD01_DEVICE_NAME=PD01

# Optional. Set this only when several printers share the same name.
# Never commit a real device address.
PD01_DEVICE_ADDRESS=

# Safe default: listen on this computer only.
MCP_HOST=127.0.0.1
MCP_PORT=4176

# Optional Windows TTF/TTC font path.
PD01_FONT_PATH=

# 8192-65535. Start conservatively to protect the print head.
PD01_PRINT_ENERGY=32768
